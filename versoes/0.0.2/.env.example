# Modelo apenas: preencha segredos reais no .env local ou no painel do serviço.
# Nunca publique o .env real, nem compartilhe chaves por mensagem.
# Chaves de sessão, identificação e conexão com o banco.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
CPF_HASH_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Configuração de cookies e URL usada para formar links de e-mail.
PUBLIC_BASE_URL=https://your-service.onrender.com
SESSION_COOKIE_SECURE=1
# SMTP legado; só é selecionado quando EMAIL_PROVIDER=smtp.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=site@example.com
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
# Alternativa por HTTPS: Gmail API, selecionada por EMAIL_PROVIDER=gmail_api.
SMTP_USE_TLS=1
EMAIL_PROVIDER=gmail_api
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=replace-with-google-oauth-refresh-token
# Endereço de remetente autorizado na configuração do Gmail.
GMAIL_FROM=account@gmail.com
# Endereço local do servidor; a hospedagem pode fornecer PORT automaticamente.
HOST=0.0.0.0
PORT=5000
